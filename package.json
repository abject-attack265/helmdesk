{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "php artisan typescript:transform --ansi",
        "dev": "vite",
        "prebuild": "php artisan typescript:transform --ansi",
        "build": "vite build",
        "prebuild:ssr": "php artisan typescript:transform --ansi",
        "build:ssr": "vite build && vite build --ssr",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "vue-tsc --noEmit",
        "test:browser:widget-host-bridge": "node tests/Browser/widget-host-bridge.spec.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.1.1",
        "@types/qrcode": "^1.5.6",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "playwright": "^1.62.0",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vue-tsc": "^3.3.8"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.6.1",
        "@inertiajs/vue3": "^3.6.1",
        "@lucide/vue": "^1.27.0",
        "@vueuse/core": "^14.3.0",
        "@vvo/tzdb": "^6.198.0",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "docx-preview": "^0.4.0",
        "dompurify": "^3.4.12",
        "laravel-vite-plugin": "^3.1.3",
        "marked": "^18.0.7",
        "pdfjs-dist": "^6.1.200",
        "qrcode": "^1.5.4",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vditor": "^3.11.2",
        "vue": "^3.5.40",
        "vue-input-otp": "^0.3.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.62.3",
        "@rollup/rollup-win32-x64-msvc": "^4.62.3",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    },
    "allowScripts": {
        "fsevents": false,
        "vue-demi@0.14.10": true
    }
