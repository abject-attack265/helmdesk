{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "helmdesk/helmdesk",
  "type": "project",
  "description": "An easy-to-deploy, AI-native, self-hosted customer support platform for small and medium-sized teams.",
  "keywords": [
    "ai",
    "customer-support",
    "helpdesk",
    "knowledge-base",
    "laravel",
    "live-chat",
    "multi-channel",
    "self-hosted"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-fileinfo": "*",
    "inertiajs/inertia-laravel": "^3.0",
    "jenssegers/agent": "^2.6",
    "laravel-lang/common": "^6.7",
    "laravel/fortify": "^1.37.3",
    "laravel/framework": "^13.22.0",
    "laravel/octane": "^2.18.0",
    "laravel/sanctum": "^4.3.3",
    "laravel/scout": "^11.4.0",
    "laravel/tinker": "^3.0",
    "laravel/wayfinder": "^0.1.9",
    "league/commonmark": "^2.8",
    "league/flysystem-aws-s3-v3": "^3.0",
    "lorisleiva/laravel-actions": "^2.10.2",
    "neuron-core/neuron-laravel": "^1.1",
    "nxp/math-executor": "^2.3.8",
    "phpdocumentor/type-resolver": "^2.0",
    "phpoffice/phpspreadsheet": "^5.7",
    "phpoffice/phpword": "^1.4",
    "smalot/pdfparser": "^2.12",
    "spatie/laravel-data": "^4.18",
    "spatie/laravel-settings": "^3.6",
    "spatie/laravel-typescript-transformer": "^3.2",
    "symfony/http-client": "^8.0",
    "teamtnt/laravel-scout-tntsearch-driver": "^16.1",
    "w7corp/easywechat": "^6.19"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/boost": "^2.4.13",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.24",
    "laravel/sail": "^1.64.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "pestphp/pest": "^4.2",
    "pestphp/pest-plugin-laravel": "^4.0",
    "romanzipp/laravel-model-doc": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install",
      "npm run build"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ],
    "post-autoload-dump": [
      "@php -r \"is_dir('storage/database') || mkdir('storage/database', 0755, true);\"",
      "@php -r \"file_exists('storage/database/main.sqlite') || touch('storage/database/main.sqlite');\"",
      "@php -r \"file_exists('storage/database/rag.sqlite') || touch('storage/database/rag.sqlite');\"",
      "@php -r \"file_exists('storage/database/session.sqlite') || touch('storage/database/session.sqlite');\"",
      "@php -r \"file_exists('storage/database/cache.sqlite') || touch('storage/database/cache.sqlite');\"",
      "@php -r \"file_exists('storage/database/jobs.sqlite') || touch('storage/database/jobs.sqlite');\"",
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "codegen": [
      "@php artisan model-doc:generate --ansi",
      "@php artisan typescript:transform --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
